# Notifications
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_NGO=
DISCORD_BOT_TOKEN=
DISCORD_COMMAND_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduling
SOURCE_GROUP_A_INTERVAL_MINUTES=60
SOURCE_GROUP_B_INTERVAL_MINUTES=120
SOURCE_GROUP_A_STARTUP_DELAY_MINUTES=1
SOURCE_GROUP_B_STARTUP_DELAY_MINUTES=6
SOURCE_GROUP_MISFIRE_GRACE_SECONDS=300
DIGEST_INTERVAL_HOURS=6

# Filters
LOCATION_ALLOWLIST=worldwide,eu,europe,germany,berlin,remote
LOCATION_BLOCKLIST=uk only,united kingdom,london,us only,canada only
MIN_NGO_SCORE=1

# Company blocklist — comma-separated company names to always skip
COMPANY_BLOCKLIST=TechBiz Global,Lemon.io,A.Team,Zipdev,Turing,Toptal

# Optional quality filters (off by default)
FILTER_SENIOR_ONLY=false
MIN_SALARY_EUR=0

# Concurrency
MAX_CONCURRENT_SOURCE_ADAPTERS=2
MAX_CONCURRENT_SOURCE_COMPONENTS=3
MAX_CONCURRENT_HTTP_REQUESTS=4
# Deprecated fallback for adapter concurrency only:
# MAX_CONCURRENT_SOURCES=2

# Passive company discovery from aggregator apply links
ENABLE_ATS_SNIFFING=true

# Optional Zoho Mail ingestion (read-only OAuth scopes only)
ZOHO_MAIL_SYNC_ENABLED=false
ZOHO_MAIL_SYNC_INTERVAL_MINUTES=180
ZOHO_MAIL_SYNC_DRY_RUN=true
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
# Use https://accounts.zoho.eu for EU accounts, https://accounts.zoho.com for US/global.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_REDIRECT_URI=http://localhost
# Optional override. If blank, the worker derives mail.zoho.<dc> from OAuth/api settings.
ZOHO_MAIL_API_BASE=
ZOHO_OAUTH_TOKEN_FILE=./data/private/zoho_oauth_token.json
# Optional ISO timestamp, e.g. 2025-01-01T00:00:00+00:00. Blank = full available history.
ZOHO_INITIAL_SYNC_FROM=
ZOHO_SYNC_OVERLAP_HOURS=48
ZOHO_FOLDER_PAGE_LIMIT=200
ZOHO_COMPANY_DISCOVERY_ENABLED=true
ZOHO_DISCOVERY_SEED_FILE=./data/discovery/zoho_mail_candidates.txt
ZOHO_DISCOVERY_MIN_CONFIDENCE=0.65
ZOHO_SKIP_FOLDERS=drafts,spam,trash,templates,outbox

# Health endpoint
HEALTH_PORT=8080

# Database
DATABASE_PATH=./data/jobs.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/job_bot.log
